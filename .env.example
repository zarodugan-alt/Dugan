# Dugan is BYOK (Bring Your Own Key). Nothing here is read at build time by default --
# the app reads keys at runtime from EncryptedSharedPreferences, which you populate
# in Onboarding or Settings. These variables exist only if you want to seed a debug
# build; wire them into BuildConfig yourself and never commit a populated copy.
#
#   cp .env.example .env   # .env is gitignored

# Groq -- speech-to-text AND text-to-speech, one key for both.
# Free signup: https://console.groq.com
GROQ_API_KEY=gsk_replace_me

# Google Gemini -- reasoning / thinking. Free signup: https://aistudio.google.com
# AI Studio issues `AQ.` Auth keys now; older `AIza` Standard keys still work.
GEMINI_API_KEY=AQ_replace_me

# Firebase (VoIP signalling only). Only needed if you build with -Pdugan.firebase=true
FIREBASE_PROJECT_ID=dugan-signalling
